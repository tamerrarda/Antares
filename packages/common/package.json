{
  "name": "@antares/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared off-chain seam: the single home for every network, asset and contract address (08-OFFCHAIN \u00a71), plus event decoding, retry and logging.",
  "exports": {
    ".": "./dist/index.js",
    "./networks": "./dist/networks.js",
    "./deployments": "./dist/deployments.js",
    "./events": "./dist/events.js",
    "./retry": "./dist/retry.js",
    "./logging": "./dist/logging.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
