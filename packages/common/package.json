{
  "name": "@antares/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared off-chain seam: the single home for every network, asset and contract address (08-OFFCHAIN §1), plus event decoding, the Check vocabulary every gate reports in, retry and logging.",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./networks": {
      "types": "./networks.ts",
      "default": "./dist/networks.js"
    },
    "./deployments": {
      "types": "./deployments.ts",
      "default": "./dist/deployments.js"
    },
    "./events": {
      "types": "./events.ts",
      "default": "./dist/events.js"
    },
    "./checks": {
      "types": "./checks.ts",
      "default": "./dist/checks.js"
    },
    "./retry": {
      "types": "./retry.ts",
      "default": "./dist/retry.js"
    },
    "./logging": {
      "types": "./logging.ts",
      "default": "./dist/logging.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
