# Which network this build is pointed at. There is no default anywhere in this repository
# (packages/common/networks.ts refuses to guess), and a static build cannot ask at request time —
# so the value is baked in here and a redeploy to another network means a rebuild.
NEXT_PUBLIC_NETWORK=testnet

# Optional. Overrides the RPC endpoint that `networks.ts` derives from NEXT_PUBLIC_NETWORK.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
