{
  "name": "@antares/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convenience, never authority (D-09): calls only permissionless entry points, holds no admin key, and samples the series \u03c3_realized cannot be reconstructed without (D-67).",
  "scripts": {
    "start": "node --experimental-strip-types index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "series": "node --experimental-strip-types series.ts"
  },
  "dependencies": {
    "@antares/common": "workspace:*",
    "@stellar/stellar-sdk": "^16.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
