{
  "name": "antares",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Antares \u2014 epoch-gated covered-call vault on Stellar. Off-chain workspace root.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "fmt": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js,json}\"",
    "fmt:write": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js,json}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "pnpm fmt && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm bindings:check",
    "bindings:check": "node --experimental-strip-types scripts/generate-bindings.ts",
    "bindings:write": "node --experimental-strip-types scripts/generate-bindings.ts --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
